{
  "name": "afterbuy",
  "version": "2026.10.22.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy:ai360": "npm run build && wrangler deploy --env ai360",
    "deploy:david": "npm run build && wrangler deploy --env david",
    "deploy:all": "npm run build && wrangler deploy --env ai360 && wrangler deploy --env david",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate",
    "db:migrate:d1": "wrangler d1 migrations apply afterbuy-db --remote",
    "db:migrate:d1:local": "wrangler d1 migrations apply afterbuy-db --local",
    "db:migrate:ai360": "wrangler d1 migrations apply afterbuy-db --remote --env ai360",
    "db:migrate:david": "wrangler d1 migrations apply afterbuy-db --remote --env david",
    "db:studio": "drizzle-kit studio",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "verify": "node --experimental-strip-types scripts/verify-full-system.ts",
    "db:init": "node --experimental-strip-types scripts/init-db.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.156.2"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.1",
      "esbuild": "0.25.0"
    }
  }
}
