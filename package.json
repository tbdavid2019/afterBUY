{
  "name": "afterbuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy:ai360": "npm run build && wrangler deploy --env ai360",
    "deploy:david": "npm run build && wrangler deploy --env david",
    "deploy:all": "npm run build && wrangler deploy --env ai360 && wrangler deploy --env david",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate",
    "db:migrate:d1": "wrangler d1 migrations apply afterbuy-db --remote",
    "db:migrate:d1:local": "wrangler d1 migrations apply afterbuy-db --local",
    "db:migrate:ai360": "wrangler d1 migrations apply afterbuy-db --remote --env ai360",
    "db:migrate:david": "wrangler d1 migrations apply afterbuy-db --remote --env david",
    "db:studio": "drizzle-kit studio",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "verify": "node --experimental-strip-types scripts/verify-full-system.ts",
    "db:init": "node --experimental-strip-types scripts/init-db.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.4",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^3.109.2"
  }
}