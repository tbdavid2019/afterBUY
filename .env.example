# Cloudflare / App Environment Variables
APP_NAME=afterBUY
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=your-32-character-session-secret-key-goes-here
CRON_SECRET=your-secure-cron-trigger-secret

# Email Service (Resend)
RESEND_API_KEY=re_123456789
EMAIL_FROM=afterBUY <notifications@afterbuy.app>

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@afterbuy.app

# Local Database Mode (Optional override)
DATABASE_URL=local.db
